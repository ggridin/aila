[Unit]
Description=AILA display worker

[Service]
Type=simple
WorkingDirectory=%h/.hermes
EnvironmentFile=-%h/.hermes/aila-body/workers/display/.env
ExecStart=%h/.hermes/venv/bin/aila-worker display --config %h/.hermes/aila-body/workers/display/config.yaml --registry %h/.hermes/config.yaml --queue-dir %h/.hermes/aila-body/queue
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/.hermes/aila-body/logs/display.log
StandardError=append:%h/.hermes/aila-body/logs/display.err.log

[Install]
WantedBy=default.target
