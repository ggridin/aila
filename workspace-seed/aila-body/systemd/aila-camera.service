[Unit]
Description=AILA camera worker
Requires=aila-device-camera-input.service
After=aila-device-camera-input.service

[Service]
Type=simple
WorkingDirectory=%h/.hermes
EnvironmentFile=-%h/.hermes/aila-body/workers/camera/.env
ExecStart=%h/.hermes/venv/bin/aila-worker camera --config %h/.hermes/aila-body/workers/camera/config.yaml --registry %h/.hermes/config.yaml --queue-dir %h/.hermes/aila-body/queue --device-service-config %h/.hermes/aila-body/device-services/camera-input/config.yaml
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/.hermes/aila-body/logs/camera.log
StandardError=append:%h/.hermes/aila-body/logs/camera.err.log

[Install]
WantedBy=default.target
