[Unit]
Description=AILA camera-input device service

[Service]
Type=simple
WorkingDirectory=%h/.hermes
ExecStart=%h/.hermes/venv/bin/python -c "from pathlib import Path; import signal; from aila.device_services import load_device_service_config; load_device_service_config(Path('%h/.hermes/aila-body/device-services/camera-input/config.yaml')); signal.pause()"
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/.hermes/aila-body/logs/device-camera-input.log
StandardError=append:%h/.hermes/aila-body/logs/device-camera-input.err.log

[Install]
WantedBy=default.target
