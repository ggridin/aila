[Unit]
Description=AILA filesystem worker

[Service]
Type=simple
WorkingDirectory=%h/.hermes
EnvironmentFile=-%h/.hermes/aila-body/workers/filesystem/.env
ExecStart=%h/.hermes/venv/bin/aila-worker filesystem --config %h/.hermes/aila-body/workers/filesystem/config.yaml --registry %h/.hermes/config.yaml --queue-dir %h/.hermes/aila-body/queue
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/.hermes/aila-body/logs/filesystem.log
StandardError=append:%h/.hermes/aila-body/logs/filesystem.err.log

[Install]
WantedBy=default.target
