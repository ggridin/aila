# Copy to .env on the target and set mode 600.
OPENROUTER_API_KEY=replace-with-openrouter-api-key
HINDSIGHT_LLM_API_KEY=replace-with-openrouter-api-key
LCM_CONTEXT_THRESHOLD=0.35
LCM_FRESH_TAIL_COUNT=32
LCM_INCREMENTAL_MAX_DEPTH=3
LCM_LEAF_CHUNK_TOKENS=20000
LCM_DATABASE_PATH=~/.hermes/lcm.db
LCM_ENABLE_SLASH_COMMAND=false
